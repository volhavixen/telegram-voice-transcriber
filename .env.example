# Токен бота, который выдаёт @BotFather в Telegram
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Через запятую перечислите Telegram user_id, которым бот разрешит пользоваться.
# Если оставить пустым — бот отвечает всем, кто ему пишет (не рекомендуется).
# Узнать свой user_id можно, например, у бота @userinfobot.
ALLOWED_USER_IDS=

# Размер модели Whisper: tiny, base, small, medium, large-v3
# Чем больше модель — тем точнее распознавание, но тем больше нужно CPU/RAM и тем дольше обработка.
# Для сервера с 1 ГБ RAM начните с "tiny"; более крупные модели требуют больше памяти.
WHISPER_MODEL_SIZE=tiny

# Устройство для инференса: cpu или cuda (если есть видеокарта Nvidia)
WHISPER_DEVICE=cpu

# Тип вычислений: int8 (быстрее и легче на CPU), float16 (для GPU), float32 (точнее, но медленнее)
WHISPER_COMPUTE_TYPE=int8

# Язык распознавания. Если не указан — модель будет автоопределять язык (немного медленнее и менее точно).
WHISPER_LANGUAGE=ru

# Число CPU-потоков для распознавания (0 = определить автоматически). Увеличьте
# на мощном сервере с большим числом ядер, чтобы ускорить каждую расшифровку —
# бот и так обрабатывает файлы по одному, поэтому выгоднее выделить больше
# потоков на одну расшифровку, чем пытаться считать несколько параллельно.
WHISPER_CPU_THREADS=0

# Максимальная длительность одного аудио в секундах (по умолчанию 30 минут).
MAX_AUDIO_DURATION=1800

# Максимальное число ожидающих сообщений, чтобы не исчерпать диск и память.
MAX_QUEUE_SIZE=20

# Поддержка файлов больше 20 МБ (необязательно). Обычный Telegram Bot API не
# позволяет боту скачивать файлы крупнее 20 МБ. Чтобы снять это ограничение
# (до ~2 ГБ) без своего сервера, получите бесплатные API_ID и API_HASH на
# https://my.telegram.org (Api development tools) и укажите их здесь. Если
# оставить пустыми — большие файлы бот вежливо отклонит с пояснением.
API_ID=
API_HASH=
